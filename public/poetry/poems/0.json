[{"id":"ba-zhen-tu-du-fu","title":"八阵图","author":"杜甫","dynasty":"唐","form":"五言绝句","themes":["怀古","哲理","写人"],"level":0,"lines":[{"zh":"功盖三分国，","py":["gōng","gài","sān","fēn","guó",""]},{"zh":"名成八阵图。","py":["míng","chéng","bā","zhèn","tú",""]},{"zh":"江流石不转，","py":["jiāng","liú","shí","bù","zhuǎn",""]},{"zh":"遗恨失吞吴。","py":["yí","hèn","shī","tūn","wú",""]}],"gist":""},{"id":"cai-lian-qu-liu-fang-ping","title":"采莲曲","author":"刘方平","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"落日清江里，","py":["luò","rì","qīng","jiāng","lǐ",""]},{"zh":"荆歌艳楚腰。","py":["jīng","gē","yàn","chǔ","yāo",""]},{"zh":"采莲从小惯，","py":["cǎi","lián","cóng","xiǎo","guàn",""]},{"zh":"十五即乘潮。","py":["shí","wǔ","jí","chéng","cháo",""]}],"gist":""},{"id":"chi-shang-bai-ju-yi","title":"池上","author":"白居易","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"小娃撑小艇，","py":["xiǎo","wá","chēng","xiǎo","tǐng",""]},{"zh":"偷采白莲回。","py":["tōu","cǎi","bái","lián","huí",""]},{"zh":"不解藏踪迹，","py":["bù","jiě","cáng","zōng","jì",""]},{"zh":"浮萍一道开。","py":["fú","píng","yī","dào","kāi",""]}],"gist":""},{"id":"chun-xue-liu-fang-ping","title":"春雪","author":"刘方平","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"飞雪带春风，","py":["fēi","xuě","dài","chūn","fēng",""]},{"zh":"徘徊乱绕空。","py":["pái","huái","luàn","rào","kōng",""]},{"zh":"君看似花处，","py":["jūn","kàn","shì","huā","chù",""]},{"zh":"偏在洛城东。","py":["piān","zài","luò","chéng","dōng",""]}],"gist":""},{"id":"chun-yuan-jin-chang-xu","title":"春怨","author":"金昌绪","dynasty":"唐","form":"五言绝句","themes":["怀人","闺怨"],"level":0,"lines":[{"zh":"打起黄莺儿，","py":["dǎ","qǐ","huáng","yīng","ér",""]},{"zh":"莫教枝上啼。","py":["mò","jiào","zhī","shàng","tí",""]},{"zh":"啼时惊妾梦，","py":["tí","shí","jīng","qiè","mèng",""]},{"zh":"不得到辽西。","py":["bù","dé","dào","liáo","xī",""]}],"gist":""},{"id":"deng-le-you-yuan-li-shang-yin","title":"登乐游原","author":"李商隐","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"向晚意不适，","py":["xiàng","wǎn","yì","bù","shì",""]},{"zh":"驱车登古原。","py":["qū","chē","dēng","gǔ","yuán",""]},{"zh":"夕阳无限好，","py":["xī","yáng","wú","xiàn","hǎo",""]},{"zh":"只是近黄昏。","py":["zhǐ","shì","jìn","huáng","hūn",""]}],"gist":""},{"id":"du-han-jiang-li-pin","title":"渡汉江","author":"李频","dynasty":"唐","form":"五言绝句","themes":["思乡","渡江"],"level":0,"lines":[{"zh":"岭外音书绝，","py":["lǐng","wài","yīn","shū","jué",""]},{"zh":"经冬复立春。","py":["jīng","dōng","fù","lì","chūn",""]},{"zh":"近乡情更怯，","py":["jìn","xiāng","qíng","gèng","qiè",""]},{"zh":"不敢问来人。","py":["bù","gǎn","wèn","lái","rén",""]}],"gist":""},{"id":"feng-xue-su-bian-rong-shan-zhu-ren-liu-zhang-qing","title":"逢雪宿鞭蓉山主人","author":"刘长卿","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"日暮苍山远，","py":["rì","mù","cāng","shān","yuǎn",""]},{"zh":"天寒白屋贫。","py":["tiān","hán","bái","wū","pín",""]},{"zh":"柴门闻犬吠，","py":["chái","mén","wén","quǎn","fèi",""]},{"zh":"风雪夜归人。","py":["fēng","xuě","yè","guī","rén",""]}],"gist":""},{"id":"ge-shu-ge-xi-bi-ren","title":"哥舒歌","author":"西鄙人","dynasty":"唐","form":"五言绝句","themes":["赞颂","民歌"],"level":0,"lines":[{"zh":"北斗七星高，","py":["běi","dǒu","qī","xīng","gāo",""]},{"zh":"哥舒夜带刀。","py":["gē","shū","yè","dài","dāo",""]},{"zh":"至今窥牧马，","py":["zhì","jīn","kuī","mù","mǎ",""]},{"zh":"不敢过临洮。","py":["bù","gǎn","guò","lín","táo",""]}],"gist":""},{"id":"gu-zhu-cheng-qu-er-shou-yuan-zhen","title":"古筑城曲（二首）","author":"元稹","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"筑城须努力，","py":["zhù","chéng","xū","nǔ","lì",""]},{"zh":"城高遮得贼。","py":["chéng","gāo","zhē","dé","zéi",""]},{"zh":"但恐贼路多，","py":["dàn","kǒng","zéi","lù","duō",""]},{"zh":"有城遮不得。","py":["yǒu","chéng","zhē","bù","dé",""]}],"gist":""},{"id":"gui-yuan-ci-bai-ju-yi","title":"闺怨词","author":"白居易","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"关山征戍远，","py":["guān","shān","zhēng","shù","yuǎn",""]},{"zh":"闺阁别离难。","py":["guī","gé","bié","lí","nán",""]},{"zh":"苦战应憔悴，","py":["kǔ","zhàn","yīng","qiáo","cuì",""]},{"zh":"寒衣不要宽。","py":["hán","yī","bú","yào","kuān","