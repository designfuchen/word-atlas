[{"id":"zai-jing-hu-cheng-xian-du-xun-he","title":"再经胡城县","author":"杜荀鹤","dynasty":"唐","form":"七言绝句","themes":[],"level":1,"lines":[{"zh":"去岁曾经此县城，","py":["qù","suì","céng","jīng","cǐ","xiàn","chéng",""]},{"zh":"县民无口不冤声。","py":["xiàn","mín","wú","kǒu","bù","yuān","shēng",""]},{"zh":"今来县宰加朱绂，","py":["jīn","lái","xiàn","zǎi","jiā","zhū","fú",""]},{"zh":"便是生灵血染成。","py":["biàn","shì","shēng","líng","xuè","rǎn","chéng",""]}],"gist":""},{"id":"zao-chun-han-yu","title":"早春","author":"韩愈","dynasty":"唐","form":"七言绝句","themes":[],"level":1,"lines":[{"zh":"天街小雨润如酥，","py":["tiān","jiē","xiǎo","yǔ","rùn","rú","sū",""]},{"zh":"草色遥看近却无。","py":["cǎo","sè","yáo","kàn","jìn","què","wú",""]},{"zh":"最是一年春好处，","py":["zuì","shì","yī","nián","chūn","hǎo","chù",""]},{"zh":"绝胜烟柳满皇都。","py":["jué","shèng","yān","liǔ","mǎn","huáng","dōu",""]}],"gist":""},{"id":"zao-fa-bai-di-cheng-li-bai","title":"早发白帝城","author":"李白","dynasty":"唐","form":"七言绝句","themes":["长江","山","喜悦","描写山","写山"],"level":1,"lines":[{"zh":"朝辞白帝彩云间，","py":["cháo","cí","bái","dì","cǎi","yún","jiān",""]},{"zh":"千里江陵一日还。","py":["qiān","lǐ","jiāng","líng","yī","rì","hái",""]},{"zh":"两岸猿声啼不住，","py":["liǎng","àn","yuán","shēng","tí","bú","zhù",""]},{"zh":"轻舟已过万重山。","py":["qīng","zhōu","yǐ","guò","wàn","zhòng","shān",""]}],"gist":""},{"id":"zao-mei-zhang-wei","title":"早梅","author":"张谓","dynasty":"唐","form":"七言绝句","themes":[],"level":1,"lines":[{"zh":"一权寒梅白玉条，","py":["yī","quán","hán","méi","bái","yù","tiáo",""]},{"zh":"迥临村路傍溪桥。","py":["jiǒng","lín","cūn","lù","bàng","xī","qiáo",""]},{"zh":"不知近水花先发，","py":["bù","zhī","jìn","shuǐ","huā","xiān","fā",""]},{"zh":"疑是经冬雪未销。","py":["yí","shì","jīng","dōng","xuě","wèi","xiāo",""]}],"gist":""},{"id":"zeng-hua-qing-du-fu","title":"赠花卿","author":"杜甫","dynasty":"唐","form":"七言绝句","themes":[],"level":1,"lines":[{"zh":"锦城丝管日纷纷，","py":["jǐn","chéng","sī","guǎn","rì","fēn","fēn",""]},{"zh":"半入江风半入云。","py":["bàn","rù","jiāng","fēng","bàn","rù","yún",""]},{"zh":"此曲只应天上有，","py":["cǐ","qū","zhǐ","yīng","ti