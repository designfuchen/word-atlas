:"王昌龄","dynasty":"唐","form":"五言律诗","themes":[],"level":1,"lines":[{"zh":"蝉鸣空桑林，","py":["chán","míng","kōng","sāng","lín",""]},{"zh":"八月萧关道。","py":["bā","yuè","xiāo","guān","dào",""]},{"zh":"出塞复入塞，","py":["chū","sài","fù","rù","sāi",""]},{"zh":"处处共芦草。","py":["chù","chù","gòng","lú","cǎo",""]},{"zh":"从来幽并客，","py":["cóng","lái","yōu","bìng","kè",""]},{"zh":"皆共尘沙老。","py":["jiē","gòng","chén","shā","lǎo",""]},{"zh":"莫学游侠儿，","py":["mò","xué","yóu","xiá","ér",""]},{"zh":"矜夸紫骝好。","py":["jīn","kuā","zǐ","liú","hǎo",""]}],"gist":""},{"id":"sai-xia-qu-wang-chang-ling","title":"塞下曲","author":"王昌龄","dynasty":"唐","form":"五言律诗","themes":[],"level":1,"lines":[{"zh":"饮马渡秋水，","py":["yǐn","mǎ","dù","qiū","shuǐ",""]},{"zh":"水寒风似刀。","py":["shuǐ","hán","fēng","shì","dāo",""]},{"zh":"平沙日未没，","py":["píng","shā","rì","wèi","méi",""]},{"zh":"黯黯见临洮。","py":["àn","àn","jiàn","lín","táo",""]},{"zh":"昔日长城战，","py":["xī","rì","cháng","chéng","zhàn",""]},{"zh":"咸言意气高。","py":["xián","yán","yì","qì","gāo",""]},{"zh":"黄尘足今古，","py":["huáng","chén","zú","jīn","gǔ",""]},{"zh":"白骨乱蓬蒿。","py":["bái","gǔ","luàn","péng","hāo",""]}],"gist":""},{"id":"shu-bian-shi-zhang-qiao","title":"书边事","author":"张乔","dynasty":"唐","form":"五言律诗","themes":["生活","边塞"],"level":1,"lines":[{"zh":"调角断清秋，","py":["diào","jiǎo","duàn","qīng","qiū",""]},{"zh":"征人倚戍楼。","py":["zhēng","rén","yǐ","shù","lóu",""]},{"zh":"春风对青冢，","py":["chūn","fēng","duì","qīng","zhǒng",""]},{"zh":"白日落梁州。","py":["bái","rì","luò","liáng","zhōu",""]},{"zh":"大漠无兵阻，","py":["dà","mò","wú","bīng","zǔ",""]},{"zh":"穷边有客游。","py":["qióng","biān","yǒu","kè","yóu",""]},{"zh":"蕃情似此水，","py":["fān","qíng","shì","cǐ","shuǐ",""]},{"zh":"长愿向南流。","py":["zhǎng","yuàn","xiàng","nán","liú",""]}],"gist":""},{"id":"shu-xian-zhu-miao-liu-yu-xi","title":"蜀先主庙","author":"刘禹锡","dynasty":"唐","form":"五言律诗","themes":["咏史怀古"],"level":1,"lines":[{"zh":"天地英雄气，","py":["tiān","dì","yīng","xióng","qì",""]},{"zh":"千秋尚凛然。","py":["qiān","qiū","shàng","lǐn","rán",""]},{"zh":"势分三足鼎，","py":["shì","fēn","sān","zú","dǐng",""]},{"zh":"业复五铢钱。","py":["yè","fù","wǔ","zhū","qián",""]},{"zh":"得相能开国，","py":["dé","xiāng","néng","kāi","guó",""]},{"zh":"生儿不象贤。","py":["shēng","ér","bù","xiàng","xián",""]},{"zh":"凄凉蜀故伎，","py":["qī","liáng","shǔ","gù","jì",""]},{"zh":"来舞魏宫前。","py":["lái","wǔ","wèi","gōng","qián",""]}],"gist":""},{"id":"song-li-duan-lu-lun","title":"送李端","author":"卢纶","dynasty":"唐","form":"五言律诗","themes":[],"level":1,"lines":[{"zh":"故关衰草遍，","py":["gù","guān","shuāi","cǎo","biàn",""]},{"zh":"离别正堪悲。","py":["lí","bié","zhèng","kān","bēi",""]},{"zh":"路出寒云外，","py":["lù","chū","hán","yún","wài",""]},{"zh":"人归暮雪时。","py":["rén","guī","mù","xuě","shí",""]},{"zh":"少孤为客早，","py":["shǎo","gū","wèi","kè","zǎo",""]},{"zh":"多难识君迟。","py":["duō","nán","shí","jūn","chí",""]},{"zh":"掩泣空相向，","py":["yǎn","qì","kōng","xiāng","xiàng",""]},{"zh":"风尘何所期。","py":["fēng","chén","hé","suǒ","qī",""]}],"gist":""},{"id":"song-li-zhong-cheng-gui-han-yang-bie-ye-liu-zhang-qing","title":"送李中丞归汉阳别业","author":"刘长卿","dynasty":"唐","form":"五言律诗","themes":[],"level":1,"lines":[{"zh":"流落征南将，","py":["liú","luò","zhēng","nán","jiāng",""]},{"zh":"曾驱十万师。","py":["céng","qū","shí","wàn","shī",""]},{"zh":"罢归无旧业，","py":["bà","guī","wú","jiù","yè",""]},{"zh":"老去恋明时。","py":["lǎo","qù","liàn","míng","shí",""]},{"zh":"独立三边静，","py":["dú","lì","sān","biān","jìng",""]},{"zh":"轻生一剑知。","py":["qīng","shēng","yī","jiàn","zhī",""]},{"zh":"茫茫江汉上，","py":["máng","máng","jiāng","hàn","shàng",""]},{"zh":"日暮欲何之。","py":["rì","mù","yù","hé","zhī",""]}],"gist":""},{"id":"song-ren-dong-gui-wen-ting-yun","title":"送人东归","author":"温庭筠","dynasty":"唐","form":"五言律诗","themes":[],"level":1,"lines":[{"zh":"荒戍落黄叶，","py":["huāng","shù","luò","huáng","yè",""]},{"zh":"浩然离故关。","py":["hào","rán","lí","gù","guān",""]},{"zh":"高风汉阳渡，","py":["gāo","fēng","hàn","yáng","dù",""]},{"zh":"初日郢门山。","py":["chū","rì","yǐng","mén","shān",""]},{"zh":"江上几人在，","py":["jiāng","shàng","jǐ","rén","zài",""]},{"zh":"天涯孤棹还。","py":["tiān","yá","gū","zhào","hái",""]},{"zh"