","zhào","luò","yáng","rén",""]},{"zh":"残钟广陵树。","py":["cán","zhōng","guǎng","líng","shù",""]},{"zh":"今朝此为别，","py":["jīn","zhāo","cǐ","wèi","bié",""]},{"zh":"何处还相遇。","py":["hé","chù","hái","xiāng","yù",""]},{"zh":"世事波上舟，","py":["shì","shì","bō","shàng","zhōu",""]},{"zh":"沿洄安得住？","py":["yán","huí","ān","dé","zhù",""]}],"gist":""},{"id":"chu-ye-you-huai-cui-tu","title":"除夜有怀","author":"崔涂","dynasty":"唐","form":"五言律诗","themes":[],"level":1,"lines":[{"zh":"迢递三巴路，","py":["tiáo","dì","sān","bā","lù",""]},{"zh":"羁危万里身。","py":["jī","wēi","wàn","lǐ","shēn",""]},{"zh":"乱山残雪夜，","py":["luàn","shān","cán","xuě","yè",""]},{"zh":"孤独异乡人。","py":["gū","dú","yì","xiāng","rén",""]},{"zh":"渐与骨肉远，","py":["jiàn","yǔ","gǔ","ròu","yuǎn",""]},{"zh":"转于童仆亲。","py":["zhuǎn","yú","tóng","pú","qīn",""]},{"zh":"那堪正漂泊，","py":["nà","kān","zhèng","piāo","bó",""]},{"zh":"明日岁华新。","py":["míng","rì","suì","huá","xīn",""]}],"gist":""},{"id":"chun-su-zuo-sheng-du-fu","title":"春宿左省","author":"杜甫","dynasty":"唐","form":"五言律诗","themes":["爱国","写景"],"level":1,"lines":[{"zh":"花隐掖垣暮，","py":["huā","yǐn","yē","yuán","mù",""]},{"zh":"啾啾栖鸟过。","py":["jiū","jiū","qī","niǎo","guò",""]},{"zh":"星临万户动，","py":["xīng","lín","wàn","hù","dòng",""]},{"zh":"月傍九霄多。","py":["yuè","bàng","jiǔ","xiāo","duō",""]},{"zh":"不寝听金钥，","py":["bù","qǐn","tīng","jīn","yào",""]},{"zh":"因风想玉珂。","py":["yīn","fēng","xiǎng","yù","kē",""]},{"zh":"明朝有封事，","py":["míng","cháo","yǒu","fēng","shì",""]},{"zh":"数问夜如何？","py":["shù","wèn","yè","rú","hé",""]}],"gist":""},{"id":"ci-bei-gu-shan-xia-wang-wan","title":"次北固山下","author":"王湾","dynasty":"唐","form":"五言律诗","themes":["地点","初中古诗","哲理","思乡"],"level":1,"lines":[{"zh":"客路青山外，","py":["kè","lù","qīng","shān","wài",""]},{"zh":"行舟绿水前。","py":["xíng","zhōu","lǜ","shuǐ","qián",""]},{"zh":"潮平两岸阔，","py":["cháo","píng","liǎng","àn","kuò",""]},{"zh":"风正一帆悬。","py":["fēng","zhèng","yī","fān","xuán",""]},{"zh":"海日生残夜，","py":["hǎi","rì","shēng","cán","yè",""]},{"zh":"江春入旧年。","py":["jiāng","chūn","rù","jiù","nián",""]},{"zh":